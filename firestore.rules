rules_version = '2';

// Job Nexus — Firestore security rules.
//
// Every document lives under users/{userId}/..., so ownership is the whole
// model: a signed-in user can read and write their own subtree and nothing
// else. There is no cross-user or public read anywhere in the app.
//
// This file exists because the project was previously running on Firebase
// test-mode rules, which carry a hard expiry date. When that date passed,
// every read and write started returning PERMISSION_DENIED and the job
// tracker went dark. Rules are config, but they are load-bearing config:
// keep them here, in version control, not only in the console.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own subtree: applications and anything nested under them.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied. Resume text, embeddings, and rate limits
    // live in Supabase and are reached only through the server-side API,
    // so nothing else belongs in Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
